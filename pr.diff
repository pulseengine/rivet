+}
+
+// rivet: verifies REQ-408
+#[test]
+fn yaml_to_json_refuses_a_tag_with_line_and_column() {
+    let (_d, path) = yaml_file("a: 1\nb: !t x\n");
+    let (ok, stdout, stderr) = yaml_to_json(&[&path], None);
+    assert!(!ok, "a tag must exit non-zero");
